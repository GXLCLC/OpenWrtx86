# ============================================================================
# ImmortalWrt X86_64 编译配置文件
#
# 使用说明:
#   1. 本文件为固件编译的总配置, 使用者可直接修改本文件灵活增减插件,
#      提交后在 Actions 页面手动触发编译即可生效;
#   2. 增加插件: 添加一行 CONFIG_PACKAGE_插件名=y;
#      移除插件: 删除对应行, 或改为 "# CONFIG_PACKAGE_插件名 is not set";
#   3. 配置经 make defconfig 非交互展开依赖, 无需 menuconfig 操作;
#   4. 代理类插件仅集成 OpenClash 一个, 未添加其他任何代理类插件。
# ============================================================================

# ----------------------------------------------------------------------------
# 目标平台: 仅编译 X86_64 架构固件
# ----------------------------------------------------------------------------
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

# ----------------------------------------------------------------------------
# 镜像格式: squashfs combined IMG 镜像(仅输出 IMG 格式)
# - 同时生成 BIOS(Legacy/MBR) 与 EFI(GPT) 两种引导的 combined 镜像
# - 镜像经 gzip 压缩输出(.img.gz), 减小体积便于下载
# - 显式禁用 ISO/QCOW2/VDI/VMDK/VHDX 等其他全部镜像格式
# ----------------------------------------------------------------------------
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
CONFIG_GRUB_IMAGES=y
CONFIG_GRUB_EFI_IMAGES=y
CONFIG_TARGET_IMAGES_GZIP=y
# CONFIG_ISO_IMAGES is not set
# CONFIG_QCOW2_IMAGES is not set
# CONFIG_VDI_IMAGES is not set
# CONFIG_VMDK_IMAGES is not set
# CONFIG_VHDX_IMAGES is not set

# ----------------------------------------------------------------------------
# 分区大小: rootfs 分区共 3072MB
# - squashfs 只读系统约占数百 MB, 剩余约 2GB 作为 rootfs_data(/overlay)
#   可写空间, 用于系统运行时额外安装软件包、存放缓存以及保存配置
# ----------------------------------------------------------------------------
CONFIG_TARGET_ROOTFS_PARTSIZE=3072

# ----------------------------------------------------------------------------
# LuCI 主题: Argon 设置为系统默认主题
# - 默认主题通过 scripts/system-settings.sh 在首次启动时设置
# - luci-app-argon-config 提供 Argon 主题的可视化配置界面
# - 保留官方 bootstrap 主题作为后备
# (ImmortalWrt feeds 自带)
# ----------------------------------------------------------------------------
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-theme-bootstrap=y

# ----------------------------------------------------------------------------
# SmartDNS: 高性能 DNS 分流服务器
# (LuCI 界面与后端均由 ImmortalWrt feeds 自带)
# ----------------------------------------------------------------------------
CONFIG_PACKAGE_luci-app-smartdns=y
CONFIG_PACKAGE_smartdns=y

# ----------------------------------------------------------------------------
# AdGuardHome: 全网广告过滤与隐私保护
# (LuCI 界面与后端均由 ImmortalWrt feeds 自带)
# ----------------------------------------------------------------------------
CONFIG_PACKAGE_luci-app-adguardhome=y
CONFIG_PACKAGE_adguardhome=y

# ----------------------------------------------------------------------------
# DDNSTO: 远程控制/内网穿透管理
# (LuCI 前端来自 linkease/nas-packages-luci(main 分支),
#  后端来自 linkease/nas-packages(master 分支),
#  ImmortalWrt 无此包, 由脚本按需浅克隆, 详见 scripts/diy-part2.sh)
# ----------------------------------------------------------------------------
CONFIG_PACKAGE_luci-app-ddnsto=y
CONFIG_PACKAGE_ddnsto=y

# ----------------------------------------------------------------------------
# OFA(OpenAppFilter): 应用过滤, 使用 luci-app-oaf 界面
# (LuCI 前端 luci-app-oaf 来自 destan19/OpenAppFilter 按需浅克隆;
#  用户态后端 appfilter 与内核模块 kmod-oaf 由 ImmortalWrt feeds 自带)
# ----------------------------------------------------------------------------
CONFIG_PACKAGE_luci-app-oaf=y
CONFIG_PACKAGE_appfilter=y
CONFIG_PACKAGE_kmod-oaf=y

# ----------------------------------------------------------------------------
# Turbo ACC: 网络加速
# - 启用软件流量分载(Flow Offloading)与 BBR 拥塞控制算法
# - x86_64 平台无需 LEDE 专有的 SFE/fast-classifier 内核模块
# (ImmortalWrt 无此包, 由脚本从 LEDE luci 仓库按需浅克隆)
# ----------------------------------------------------------------------------
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_TURBOACC_INCLUDE_FLOW_OFFLOADING=y
CONFIG_PACKAGE_TURBOACC_INCLUDE_BBR_CCA=y
CONFIG_PACKAGE_kmod-ipt-offload=y
CONFIG_PACKAGE_kmod-tcp-bbr=y

# ----------------------------------------------------------------------------
# Mwan3: 多 WAN 口负载均衡/故障切换
# (LuCI 界面与后端均由 ImmortalWrt feeds 自带)
# ----------------------------------------------------------------------------
CONFIG_PACKAGE_luci-app-mwan3=y
CONFIG_PACKAGE_mwan3=y

# ----------------------------------------------------------------------------
# 带宽监控: nlbwmon 网络带宽监视器
# (按 IP/主机统计网络流量, LuCI 界面与后端均由 ImmortalWrt feeds 自带)
# ----------------------------------------------------------------------------
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_nlbwmon=y

# ----------------------------------------------------------------------------
# EasyTier: 去中心化内网穿透组网
# (LuCI 前端与后端均来自 EasyTier 官方仓库按需浅克隆;
#  kmod-tun 为其 TUN 虚拟网卡依赖)
# ----------------------------------------------------------------------------
CONFIG_PACKAGE_luci-app-easytier=y
CONFIG_PACKAGE_easytier=y
CONFIG_PACKAGE_kmod-tun=y

# ----------------------------------------------------------------------------
# OpenClash: Clash 代理客户端(本固件唯一集成的代理类插件)
# (LuCI 界面由 ImmortalWrt feeds 自带, 无需第三方拉取)
# - dnsmasq-full 为其必需的完整版 DNS 服务(自动替换默认 dnsmasq)
# - 其余依赖(bash/curl/ruby/kmod-inet-diag/kmod-nft-tproxy 等)
#   由依赖关系自动展开, 无需逐一列出
# ----------------------------------------------------------------------------
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_dnsmasq-full=y

# ----------------------------------------------------------------------------
# LuCI 基础组件与中文语言包
# - CONFIG_LUCI_LANG_zh_Hans 为 LuCI 全局语言开关,
#   自动为全部已启用的 LuCI 应用选中简体中文语言包(luci-i18n-*-zh-cn)
# ----------------------------------------------------------------------------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_LUCI_LANG_zh_Hans=y

# ----------------------------------------------------------------------------
# USB 驱动: USB 控制器与 USB 存储基础支持
# (涵盖 USB2/USB3 控制器、U 盘/移动硬盘存储及常见文件系统)
# ----------------------------------------------------------------------------
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb2-pci=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-ohci=y
CONFIG_PACKAGE_kmod-usb-uhci=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-scsi-core=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y
CONFIG_PACKAGE_kmod-nls-utf8=y

# ----------------------------------------------------------------------------
# USB 串口设备驱动(USB 转串口芯片, 常用于 4G 模块/工控设备调试)
# ----------------------------------------------------------------------------
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-ch341=y
CONFIG_PACKAGE_kmod-usb-serial-cp210x=y
CONFIG_PACKAGE_kmod-usb-serial-ftdi=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-serial-pl2303=y

# ----------------------------------------------------------------------------
# USB 网卡驱动: 支持常见 USB 有线/无线网卡
# (覆盖 ASIX/瑞昱(rtl8152系列)/SMSC/CDC 系列等常见 USB 网卡芯片,
#  以及 QMI/MBIM/RNDIS 等 4G/5G USB 上网模块)
# ----------------------------------------------------------------------------
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-asix=y
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-cdc-eem=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-cdc-subset=y
CONFIG_PACKAGE_kmod-usb-net-huawei-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-ipheth=y
CONFIG_PACKAGE_kmod-usb-net-lan78xx=y
CONFIG_PACKAGE_kmod-usb-net-pegasus=y
CONFIG_PACKAGE_kmod-usb-net-plusb=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-net-rndis-host=y
CONFIG_PACKAGE_kmod-usb-net-rtl8150=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
CONFIG_PACKAGE_kmod-usb-net-smsc75xx=y
CONFIG_PACKAGE_kmod-usb-net-smsc95xx=y
CONFIG_PACKAGE_kmod-usb-net-sr9700=y

# ----------------------------------------------------------------------------
# Intel(英特尔)系列 PCI/PCIe 有线网卡驱动
# (覆盖 e100/e1000/igb/igc/ixgbe/i40e 等全系列有线网卡)
# ----------------------------------------------------------------------------
CONFIG_PACKAGE_kmod-e100=y
CONFIG_PACKAGE_kmod-e1000=y
CONFIG_PACKAGE_kmod-e1000e=y
CONFIG_PACKAGE_kmod-igb=y
CONFIG_PACKAGE_kmod-igbvf=y
CONFIG_PACKAGE_kmod-igc=y
CONFIG_PACKAGE_kmod-ixgbe=y
CONFIG_PACKAGE_kmod-ixgbevf=y
CONFIG_PACKAGE_kmod-i40e=y
CONFIG_PACKAGE_kmod-iavf=y

# ----------------------------------------------------------------------------
# Realtek(瑞昱)系列 PCI/PCIe 有线网卡驱动
# - 8139 系列老款网卡与瑞昱 PHY 芯片驱动
# - 瑞昱千兆(rtl8116/8168/8111 系列)与 2.5G(rtl8125 系列) PCIe 网卡
#   由内核内置的 r8169 驱动直接支持, 无需额外 kmod 包
# ----------------------------------------------------------------------------
CONFIG_PACKAGE_kmod-8139cp=y
CONFIG_PACKAGE_kmod-8139too=y
CONFIG_PACKAGE_kmod-phy-realtek=y

# ----------------------------------------------------------------------------
# 磁盘与系统实用工具(轻量)
# ----------------------------------------------------------------------------
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_losetup=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_ethtool=y
