#!/bin/sh
# ============================================================================
# 固件首次启动初始化脚本(uci-defaults 机制: 首次开机自动执行, 成功后自删)
#
# 说明: 以下 LAN IP 与登录账号密码信息会同步展示在 GitHub Release
#       发布说明中, 修改本文件后请同步修改 scripts/gen-release-info.sh
#       中对应的默认设置信息
# ============================================================================

# ----------------------------------------------------------------------------
# 1. 设置默认 LAN IP 地址
# (浏览器访问该地址进入 LuCI 管理后台)
# ----------------------------------------------------------------------------
uci set network.lan.ipaddr='192.168.1.1'
uci set network.lan.netmask='255.255.255.0'
uci commit network

# ----------------------------------------------------------------------------
# 2. 设置 Argon 为系统默认主题
# (mediaurlbase 指向 argon 主题后, 登录后台即默认使用 Argon 主题)
# ----------------------------------------------------------------------------
uci set luci.main.mediaurlbase='/luci-static/argon'
uci commit luci

# ----------------------------------------------------------------------------
# 3. 设置 root 后台登录密码
# (LuCI 后台与 SSH 登录均使用此账号密码, 首次登录后请及时修改)
# 默认账号: root
# 默认密码: password
# ----------------------------------------------------------------------------
echo "root:password" | chpasswd

# ----------------------------------------------------------------------------
# 4. 设置主机名与时区
# ----------------------------------------------------------------------------
uci set system.@system[0].hostname='OpenWrt'
uci set system.@system[0].timezone='CST-8'
uci set system.@system[0].zonename='Asia/Shanghai'
uci commit system

# 脚本正常退出(uci-defaults 机制要求, 非 0 退出码会导致脚本下次开机重复执行)
exit 0
